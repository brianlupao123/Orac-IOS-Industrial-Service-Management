{
  "_about": "Single source of truth for ORAC design tokens. scripts/ux-tokens.mjs --check compares src/index.css and the HTML prototype (docs/ux/ORAC_UI_PROTOTYPE.html) against this file, and verifies contrast. --write updates both from this file. Edit THIS file to change a token, then run --write.",
  "version": 1,
  "targets": {
    "css": {
      "file": "src/index.css",
      "lightBlock": ":root",
      "darkBlock": "html[data-theme=\"dark\"]",
      "prefix": "--orac-"
    },
    "prototype": {
      "file": "docs/ux/ORAC_UI_PROTOTYPE.html",
      "lightBlock": ".frame",
      "darkBlock": ".frame[data-theme=\"dark\"]"
    }
  },
  "colors": {
    "page": {
      "css": "--orac-page",
      "proto": "--bg",
      "light": "#f3f6fa",
      "dark": "#0b0f19",
      "note": "Page background behind cards. NEW token (UXD-3)."
    },
    "canvas": {
      "css": "--orac-canvas",
      "proto": "--field",
      "light": "#ffffff",
      "dark": "#0b0f19",
      "note": "Input and field background."
    },
    "surface": {
      "css": "--orac-surface",
      "proto": "--card",
      "light": "#ffffff",
      "dark": "#141b2c",
      "note": "Cards, header, panels (UXD-3: white card on grey page)."
    },
    "surface-subtle": {
      "css": "--orac-surface-subtle",
      "proto": "--card-muted",
      "light": "#f8fafc",
      "dark": "#18203a",
      "note": "Table head, nested blocks. NEW token (UXD-3)."
    },
    "surface-muted": {
      "css": "--orac-surface-muted",
      "proto": "--neutral-bg",
      "light": "#eef2f7",
      "dark": "#1c2438",
      "note": "Chips, neutral badges, pressed states."
    },
    "row-hover": {
      "css": "--orac-row-hover",
      "proto": "--row-hover",
      "light": "#eef3f9",
      "dark": "#1f2a44",
      "note": "Clickable table row hover. NEW token."
    },
    "row-alt": {
      "css": "--orac-row-alt",
      "proto": "--row-alt",
      "light": "#f6f8fb",
      "dark": "#171f33",
      "note": "Optional zebra rows. NEW token."
    },
    "text-primary": {
      "css": "--orac-text-primary",
      "proto": "--text",
      "light": "#0b0f19",
      "dark": "#f3f6fa"
    },
    "text-secondary": {
      "css": "--orac-text-secondary",
      "proto": "--text-2",
      "light": "#3d4a5c",
      "dark": "#c3ccda"
    },
    "text-muted": {
      "css": "--orac-text-muted",
      "proto": "--text-muted",
      "light": "#5b6b80",
      "dark": "#93a0b4"
    },
    "border": {
      "css": "--orac-border",
      "proto": "--border",
      "light": "#e2e8f0",
      "dark": "#2a3348",
      "note": "Decorative dividers only."
    },
    "border-strong": {
      "css": "--orac-border-strong",
      "proto": "--border-strong",
      "light": "#64748b",
      "dark": "#7c849a",
      "note": "Inputs and essential boundaries (3:1)."
    },
    "accent": {
      "css": "--orac-accent",
      "proto": "--accent",
      "light": "#00488c",
      "dark": "#8fc4ea"
    },
    "accent-strong": {
      "css": "--orac-accent-strong",
      "proto": "--accent-strong",
      "light": "#003c74",
      "dark": "#00488c",
      "note": "Filled buttons. White text on this."
    },
    "focus-ring": {
      "css": "--orac-focus-ring",
      "proto": "--focus",
      "light": "#00488c",
      "dark": "#8fc4ea"
    },
    "success-text": {
      "css": "--orac-success-text",
      "proto": "--success-text",
      "light": "#047857",
      "dark": "#6fdda5"
    },
    "success-bg": {
      "css": "--orac-success-bg",
      "proto": "--success-bg",
      "light": "#ecfdf5",
      "dark": "#123524"
    },
    "success-border": {
      "css": "--orac-success-border",
      "proto": "--success-border",
      "light": "#047857",
      "dark": "#2a7a50"
    },
    "danger-text": {
      "css": "--orac-danger-text",
      "proto": "--danger-text",
      "light": "#b91c1c",
      "dark": "#ff9aa8"
    },
    "danger-bg": {
      "css": "--orac-danger-bg",
      "proto": "--danger-bg",
      "light": "#fef2f2",
      "dark": "#3a1620"
    },
    "danger-border": {
      "css": "--orac-danger-border",
      "proto": "--danger-border",
      "light": "#b91c1c",
      "dark": "#c94a5c"
    },
    "warning-text": {
      "css": "--orac-warning-text",
      "proto": "--warning-text",
      "light": "#92400e",
      "dark": "#f5c15b"
    },
    "warning-bg": {
      "css": "--orac-warning-bg",
      "proto": "--warning-bg",
      "light": "#fffbeb",
      "dark": "#3a2b0e"
    },
    "warning-border": {
      "css": "--orac-warning-border",
      "proto": "--warning-border",
      "light": "#92400e",
      "dark": "#b08624"
    },
    "info-text": {
      "css": "--orac-info-text",
      "proto": "--info-text",
      "light": "#0369a1",
      "dark": "#7fc4f5"
    },
    "info-bg": {
      "css": "--orac-info-bg",
      "proto": "--info-bg",
      "light": "#f0f9ff",
      "dark": "#12283f"
    },
    "info-border": {
      "css": "--orac-info-border",
      "proto": "--info-border",
      "light": "#0369a1",
      "dark": "#3f8cc2"
    }
  },
  "scale": {
    "text-caption": {
      "css": "--orac-text-caption",
      "proto": "--t-cap",
      "value": "0.75rem",
      "note": "12 px. Floor. Badges and helper text only."
    },
    "text-sm": {
      "css": "--orac-text-sm",
      "proto": "--t-sm",
      "value": "0.875rem",
      "note": "14 px. Compact density and secondary text."
    },
    "text-base": {
      "css": "--orac-text-base",
      "proto": "--t-base",
      "value": "1rem",
      "note": "16 px. Default reading text, labels, inputs, buttons, table cells."
    },
    "text-lg": {
      "css": "--orac-text-lg",
      "proto": "--t-lg",
      "value": "1.125rem",
      "note": "18 px. Section headings, card titles."
    },
    "text-xl": {
      "css": "--orac-text-xl",
      "proto": "--t-xl",
      "value": "1.25rem"
    },
    "text-2xl": {
      "css": "--orac-text-2xl",
      "proto": "--t-2xl",
      "value": "1.5rem",
      "note": "24 px. Page title."
    },
    "text-stat": {
      "css": "--orac-text-stat",
      "proto": "--t-stat",
      "value": "1.75rem",
      "note": "28 px. Counts are quieter than their labels (UXD-2)."
    },
    "space-1": {
      "css": "--orac-space-1",
      "proto": "--sp-1",
      "value": "4px"
    },
    "space-2": {
      "css": "--orac-space-2",
      "proto": "--sp-2",
      "value": "8px"
    },
    "space-3": {
      "css": "--orac-space-3",
      "proto": "--sp-3",
      "value": "12px"
    },
    "space-4": {
      "css": "--orac-space-4",
      "proto": "--sp-4",
      "value": "16px"
    },
    "space-6": {
      "css": "--orac-space-6",
      "proto": "--sp-6",
      "value": "24px"
    },
    "space-8": {
      "css": "--orac-space-8",
      "proto": "--sp-8",
      "value": "32px"
    },
    "space-12": {
      "css": "--orac-space-12",
      "proto": "--sp-12",
      "value": "48px"
    },
    "radius-sm": {
      "css": "--orac-radius-sm",
      "proto": "--r-sm",
      "value": "6px"
    },
    "radius-control": {
      "css": "--orac-radius-control",
      "proto": "--r-md",
      "value": "8px"
    },
    "radius-card": {
      "css": "--orac-radius-card",
      "proto": "--r-lg",
      "value": "12px"
    },
    "control-h": {
      "css": "--orac-control-h",
      "proto": "--ctl-h",
      "value": "44px"
    },
    "control-h-compact": {
      "css": "--orac-control-h-compact",
      "proto": "--ctl-h-compact",
      "value": "40px"
    },
    "page-max": {
      "css": "--orac-page-max",
      "proto": "--page-max",
      "value": "1440px"
    },
    "gutter": {
      "css": "--orac-gutter",
      "proto": "--gutter",
      "value": "28px"
    },
    "cell-y": {
      "css": "--orac-cell-y",
      "proto": "--cell-y",
      "value": "16px",
      "note": "Table cell vertical padding, comfortable density. NEW token."
    },
    "cell-x": {
      "css": "--orac-cell-x",
      "proto": "--cell-x",
      "value": "24px",
      "note": "Table cell horizontal padding. NEW token."
    },
    "table-font-size": {
      "css": "--orac-table-font-size",
      "proto": null,
      "value": "16px",
      "note": "Table text 16 px (UXD-1). Compact density may use text-sm."
    },
    "motion": {
      "css": "--orac-motion",
      "proto": "--motion",
      "value": "160ms ease-out"
    }
  },
  "contrast": [
    {
      "fg": [
        "text-primary",
        "text-secondary",
        "text-muted"
      ],
      "bg": [
        "page",
        "canvas",
        "surface",
        "surface-subtle",
        "surface-muted"
      ],
      "min": 4.5,
      "why": "Body text on every surface"
    },
    {
      "fg": [
        "accent"
      ],
      "bg": [
        "page",
        "canvas",
        "surface",
        "surface-subtle"
      ],
      "min": 4.5,
      "why": "Links and secondary-button text"
    },
    {
      "fg": [
        "success-text",
        "danger-text",
        "warning-text",
        "info-text"
      ],
      "bg": [
        "page",
        "surface",
        "surface-subtle"
      ],
      "min": 4.5,
      "why": "Status text on neutral surfaces"
    },
    {
      "fg": [
        "success-text"
      ],
      "bg": [
        "success-bg"
      ],
      "min": 4.5,
      "why": "Status pill"
    },
    {
      "fg": [
        "danger-text"
      ],
      "bg": [
        "danger-bg"
      ],
      "min": 4.5,
      "why": "Status pill"
    },
    {
      "fg": [
        "warning-text"
      ],
      "bg": [
        "warning-bg"
      ],
      "min": 4.5,
      "why": "Status pill"
    },
    {
      "fg": [
        "info-text"
      ],
      "bg": [
        "info-bg"
      ],
      "min": 4.5,
      "why": "Status pill"
    },
    {
      "fg": [
        "border-strong"
      ],
      "bg": [
        "page",
        "canvas",
        "surface"
      ],
      "min": 3,
      "why": "Input boundary (WCAG 1.4.11)"
    },
    {
      "fg": [
        "focus-ring"
      ],
      "bg": [
        "page",
        "canvas",
        "surface"
      ],
      "min": 3,
      "why": "Focus indicator"
    },
    {
      "fgLiteral": "#ffffff",
      "bg": [
        "accent-strong"
      ],
      "min": 4.5,
      "why": "White text on filled buttons"
    }
  ],
  "decisions": {
    "UXD-1": "Table and body text is 16 px in comfortable density; 14 px only in compact density.",
    "UXD-2": "Counts (28 px, regular weight, secondary colour) never outrank their labels (16-18 px, bold, primary colour).",
    "UXD-3": "Page is grey and cards are white. Adds --orac-page, --orac-surface-subtle, --orac-row-hover, --orac-row-alt. Light --orac-surface moves from #f8fafc to #ffffff. Owner confirmation needed before merge."
  },
  "enforce": {
    "parity": true,
    "_note": "Set parity to true at the end of Phase 1, after node scripts/ux-tokens.mjs --write has been reviewed and merged. Contrast is always enforced."
  }
}
