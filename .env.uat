# Build-time only. Contains no secrets and is safe to commit.
# Loaded ONLY when Vite is run with --mode uat (see package.json "build:uat"
# / "dev:uat"). The ordinary "build" and "dev" scripts use the default mode
# and never load this file, so VITE_UAT_STATE_MODE is absent/false there.
#
# Do not confuse this file with .env.uat.local, which holds real UAT
# capture credentials, stays untracked, and is loaded by the capture
# script itself (frontend/scripts/capture-uat-evidence.mjs), not by Vite.
VITE_UAT_STATE_MODE=true
