{
  "name": "orac-ios-frontend",
  "description": "Manage industrial service requests, quotations, purchase orders, field jobs and invoices in one place.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:uat": "vite build --mode uat --outDir dist-uat",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "preview:uat": "vite preview --outDir dist-uat",
    "uat:local": "node scripts/uat-local.mjs --serve",
    "uat:audit": "node scripts/uat-local.mjs",
    "test:visual-audit": "node scripts/ui_visual_audit.mjs",
    "test:phase5-browser": "node scripts/phase5_browser_uat.mjs",
    "finalize:handover": "node scripts/finalize-handover.mjs",
    "finalize:local": "set ORAC_BASE_URL=http://localhost:5173&& node scripts/finalize-handover.mjs",
    "maintain": "node scripts/verify-maintenance.mjs",
    "ux:check": "node scripts/ux-check.mjs",
    "ux:tokens": "node scripts/ux-tokens.mjs",
    "ux:tokens:write": "node scripts/ux-tokens.mjs --write",
    "ux:ratchet": "node scripts/ux-ratchet.mjs",
    "ux:ratchet:report": "node scripts/ux-ratchet.mjs --report",
    "ux:ratchet:update": "node scripts/ux-ratchet.mjs --update",
    "ux:probe:prototype": "node scripts/ux-probe.mjs --target prototype",
    "ux:probe:app": "node scripts/ux-probe.mjs --target app",
    "ux:trace": "node scripts/ux-trace.mjs --embed docs/ux/ORAC_UI_PROTOTYPE.html",
    "ux:export": "node scripts/orac-export.mjs --slim --with-tests"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "postcss": "^8.4.38",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
