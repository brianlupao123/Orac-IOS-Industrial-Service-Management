{
  "name": "orac-ios-frontend",
  "description": "Manage industrial service requests, quotations, purchase orders, field jobs and invoices in one place.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:uat": "vite build --mode uat --outDir dist-uat",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "preview:uat": "vite preview --outDir dist-uat",
    "test:visual-audit": "node scripts/ui_visual_audit.mjs",
    "test:phase5-browser": "node scripts/phase5_browser_uat.mjs",
    "finalize:handover": "node scripts/finalize-handover.mjs",
    "finalize:local": "set ORAC_BASE_URL=http://localhost:5173&& node scripts/finalize-handover.mjs",
    "maintain": "node scripts/verify-maintenance.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "postcss": "^8.4.38",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
